# Normalización de saltos de línea multiplataforma (Windows, macOS, Linux/Render)
* text=auto eol=lf

*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.env* text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.joblib binary
*.db binary
*.sqlite binary
*.sqlite3 binary
