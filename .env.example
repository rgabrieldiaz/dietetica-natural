# Variables de Entorno — Configuración Dietética de Barrio
# Copiar este archivo a .env y configurar claves locales

# Clave secreta para firma de cookies de sesión
SECRET_KEY=dietetica_secreta_super_segura_2026_cambiar_en_produccion

# URL de la base de datos:
# - Local (SQLite por defecto si no se define): sqlite:///dietetica.db
# - Render (PostgreSQL administrado): postgresql://usuario:password@host/nombre_bd
DATABASE_URL=sqlite:///dietetica.db

# Puerto para desarrollo local
PORT=5000
FLASK_DEBUG=True
